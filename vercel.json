{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm install --prefix app && npm install --prefix api",
  "buildCommand": "npm run build --prefix app",
  "outputDirectory": "app/dist",
  "redirects": [
    {
      "source": "/market-detail.html",
      "has": [
        {
          "type": "query",
          "key": "id",
          "value": "(?<id>[0-9]+)"
        }
      ],
      "destination": "/market/v1-:id",
      "permanent": true
    },
    {
      "source": "/market-detail.html",
      "destination": "/markets",
      "permanent": true
    },
    {
      "source": "/(predictarc|arcodds|index).html",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/markets.html",
      "destination": "/markets",
      "permanent": true
    },
    {
      "source": "/portfolio.html",
      "destination": "/portfolio",
      "permanent": true
    },
    {
      "source": "/leaderboard.html",
      "destination": "/status",
      "permanent": true
    },
    {
      "source": "/docs.html",
      "destination": "/docs",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sitemap.xml",
      "destination": "/api/sitemap"
    },
    {
      "source": "/market/:key",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": "(?i).*(bot|crawler|spider|facebookexternalhit|whatsapp|telegram|slack|discord|linkedin|embedly|skype|preview).*"
        }
      ],
      "destination": "/api/market-page?key=:key"
    },
    {
      "source": "/markets",
      "destination": "/index.html"
    },
    {
      "source": "/market/:key",
      "destination": "/index.html"
    },
    {
      "source": "/portfolio",
      "destination": "/index.html"
    },
    {
      "source": "/status",
      "destination": "/index.html"
    },
    {
      "source": "/docs",
      "destination": "/index.html"
    },
    {
      "source": "/privacy",
      "destination": "/index.html"
    },
    {
      "source": "/terms",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/resolutions",
      "destination": "/index.html"
    },
    {
      "source": "/markets/:cat",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/**/*.js": {
      "includeFiles": "networks.json"
    }
  },
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors 'none'; base-uri 'self'; object-src 'none'"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        }
      ]
    }
  ]
}
